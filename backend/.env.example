# ── BNBPRINT backend configuration ─────────────────────────────────────────
# Copy this file to `.env` and fill in real values before running in
# production. Everything works out of the box in DEMO_MODE with no keys.
#
# These same values (minus DATABASE_URL/REDIS_URL, which are legacy-path
# only — see below) go into your GitHub Actions secrets/variables for the
# $0/month scanner (backend/scan_runner.py) — see README.md §5.

# App
APP_NAME=BNBPRINT
ENV=development
# When true, the scanner emits realistic simulated tokens instead of
# connecting to a real RPC. Flip to false once RPC_WSS_URL / RPC_HTTPS_URL
# and the factory addresses below are confirmed correct.
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Upstash Redis (REST API) — the $0/month state store shared between
# scan_runner.py and the frontend's app/api/* routes. Free, no card: create
# a database at upstash.com, then copy these two values from its "REST
# API" tab. Leave blank to run scan_runner.py locally without persisting
# anything (it no-ops instead of crashing — see app/services/store.py).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy path only (see README.md's appendix) — Postgres, NOT Supabase.
# Unused by the default $0/month setup; only needed if you deploy
# app/main.py's always-on FastAPI app instead of scan_runner.py.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bnbprint

# BNB Chain RPC — get a free endpoint from Chainstack, Alchemy, Infura, or Ankr
RPC_WSS_URL=wss://bsc-mainnet.example.com/YOUR_KEY
RPC_HTTPS_URL=https://bsc-mainnet.example.com/YOUR_KEY
# Optional second HTTPS endpoint from a DIFFERENT provider than the one
# above. Automatically used whenever the primary is down or has hit its
# free-tier request limit — see app/services/security_checks.py's
# get_web3(). Leave blank to run with just the primary.
RPC_HTTPS_URL_FALLBACK=
CHAIN_ID=56

# Ave AI (security scoring) — https://ave.ai — used for honeypot/rug/liquidity
# scoring on top of our own on-chain checks.
AVE_AI_API_KEY=
AVE_AI_BASE_URL=https://prod.ave-api.com/v2

# GoPlus Security (https://gopluslabs.io) — a real, working honeypot/tax/
# LP-lock simulator. Works with NO key at a lower rate limit; sign up for a
# free App Key + Secret at gopluslabs.io for higher volume in production.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# DEX factory addresses (PancakeSwap) — official, safe to use as-is
PANCAKESWAP_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
PANCAKESWAP_V3_FACTORY=0x0BFbCF9fa4f9C56B0F40a671Ad40E0805A091865

# Bonding-curve platform factories.
#
# FOUR_MEME_FACTORY is now a VERIFIED real address (TokenManager2 on BSC),
# not a placeholder — confirmed via two independent, cross-confirming
# sources (Bitquery's four.meme API docs + the open-source four-meme-
# community/four-meme-ai integration project). scan_runner.py's
# _live_tick() fully decodes TokenCreate events from this exact address —
# see app/services/four_meme.py's docstring for the verification trail.
FOUR_MEME_FACTORY=0x5c952063c7fc8610FFDB798152D69F0B9550762b

# GRAFUN_FACTORY is also now a verified real address (their "Token Sale
# Factory" contract on BSC) — confirmed via DefiLlama's own dimension-
# adapters source, which hardcodes it for fee/volume tracking. What's
# still unconfirmed is the token-creation event's exact ABI, so
# scan_runner.py only logs activity from this address rather than
# decoding it into token cards yet — see app/services/bonding.py's
# GraFunReader docstring for the specific remaining gap.
GRAFUN_FACTORY=0x8341b19a2A602eAE0f22633b6da12E1B016E6451

# Add more "platform_name:address" pairs, comma separated, to track others
EXTRA_BONDING_FACTORIES=

# Runner scoring thresholds
RUNNER_SCORE_THRESHOLD=70
MIN_SECURITY_SCORE=50

# Push notifications (standard Web Push / VAPID — no Firebase needed)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Legacy path only — a second, different Redis used by the old always-on
# app for its own processing queue/caching (unrelated to Upstash above).
# Leave blank to fall back to an in-process asyncio queue.
REDIS_URL=

# Background task cadence (seconds) — used by both paths
BONDING_REFRESH_INTERVAL=45
STALE_TOKEN_CLEANUP_HOURS=72

# scan_runner.py loop tuning (the $0/month path) — defaults are fine for
# most cases; see .github/workflows/scanner.yml for why 5h45m/15s was
# chosen (comfortably inside GitHub's 6h job cap + the 5h cron cadence).
SCAN_POLL_INTERVAL_SECONDS=15
SCAN_LOOP_BUDGET_SECONDS=20700

# A bonding-curve token whose progress hasn't beaten its own previous
# high-water mark for this many minutes is pruned from the feed (presumed
# dead — no buys happening). Migrated tokens are never pruned. Only
# meaningful for four.meme right now — see app/services/bonding.py's
# GraFunReader docstring for why GraFun tokens aren't tracked yet.
DEAD_BONDING_MINUTES=30
